# Copia este archivo como ".env" (en la raíz del proyecto o en backend/) y llena tus valores.
# - En tu computadora la app lo lee sola al arrancar.
# - En Render: Environment -> "Add from .env" y pega el contenido.
# - En Railway: Variables -> "Raw Editor" y pega el contenido.
# Formato: NOMBRE=valor, una por línea, SIN comillas. Nunca subas el .env a GitHub.

# ---------- Obligatorias en producción ----------
# En tu computadora déjalas comentadas (con #): se usa la base local y una clave de desarrollo.
# En Render / Railway quita el # y llénalas.
# Pega la dirección de Neon / Render / Railway tal cual: postgresql://usuario:clave@host/base?sslmode=require
# DB_URL=
# Cualquier texto largo inventado, mínimo 32 caracteres
# JWT_SECRET=
# Tu email; esa cuenta será la de administrador
ADMIN_EMAILS=

# ---------- Cobros en Ecuador (transferencia / DeUna) ----------
BANK_NAME=Banco Pichincha
BANK_ACCOUNT_TYPE=Ahorros
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_HOLDER=
# Cédula o RUC del titular
BANK_HOLDER_ID=
DEUNA_PHONE=
# URL de la imagen de tu QR de DeUna (opcional)
DEUNA_QR_URL=
SUPPORT_WHATSAPP=
SUPPORT_EMAIL=

# ---------- Precios (USD) ----------
PLAN_MONTHLY_PRICE=29.00
PLAN_QUARTERLY_PRICE=79.00
PLAN_YEARLY_PRICE=290.00
TRIAL_DAYS=7

# ---------- PayPal (opcional, internacional) ----------
PAYPAL_LINK_MONTHLY=
PAYPAL_LINK_QUARTERLY=
PAYPAL_LINK_YEARLY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
